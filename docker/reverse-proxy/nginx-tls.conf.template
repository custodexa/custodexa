# Custodexa 對外 TLS termination 反向代理範本（nginx）
# 對應 openspec/specs/deployment-hardening 的 external-ingress TLS 契約。
#
# 本檔由 nginx 映像啟動時以 envsubst 展開：`${TLS_DOMAIN}` 與 `${TLS_HTTPS_PORT}`
# 取自 .env 的同名變數，展開結果落在 /etc/nginx/conf.d/default.conf。用 docker-compose.tls.yml 啟動時
# 掛載與展開都已配好，一般部署不需要打開本檔。
# 要自訂設定就複製本檔（例：cp docker/reverse-proxy/nginx-tls.conf.template
# tls/custodexa.conf.template），在 .env 以 TLS_NGINX_TEMPLATE 指向你的副本。
#
# 預設部署即以本範本啟動內建代理終止 TLS；frontend 只在內部聽 80/HTTP，不對外暴露。
# 改用外部 ingress（停用內建代理）時，TLS termination 與關閉明文暴露為部署方職責。
# 本範本即置於 Custodexa frontend 之前、負責 TLS termination 的反向代理，滿足契約：
#   - TLS 1.2+、可信憑證
#   - HTTP(80) → HTTPS(443) redirect
#   - HSTS
#   - WebSocket upgrade 轉發（wss；終端/圖形/監控串流依賴）
#   - 傳遞 X-Forwarded-Proto=https（供後端/前端正確識別外部協定）
#
# 複製後可改的位置：
#   1. server_name（兩處）：預設由 ${TLS_DOMAIN} 帶入，也可直接寫死你的網域。
#   2. 憑證路徑：預設 /etc/nginx/certs/{fullchain,privkey}.pem，對應 ./tls/ 下的兩個檔。
#   3. 額外標頭：HSTS 的 max-age 與 includeSubDomains/preload，以及你的資安要求所需的標頭。
#   4. upstream：同一 docker network 用服務名 frontend:80，經 Docker 內建 DNS（127.0.0.11）
#      在請求時解析，frontend 容器換 IP（重建、升級）後不必重啟本代理。主機安裝 nginx 的變體
#      沒有這個 DNS，請把 resolver 那行拿掉、把 $frontend_upstream 改成
#      http://127.0.0.1:<frontend 對外埠>（或改回固定 upstream 區塊）——見「不可信 hop」註記。
# 掛載成 /etc/nginx/conf.d/default.conf（或經 templates 展開成該檔）是刻意的：
# 映像內建的 default.conf 會與本設定衝突（同名 server_name），或以 welcome 頁兜底
# 吃掉不匹配網域的請求。
# `http2 on` 為 nginx 1.25.1+ 指令；舊版 nginx 改寫成 `listen 443 ssl http2;`。
#
# 不可信 hop（re-encrypt）：若此反代與 Custodexa 主機之間跨越不可信網段（如跨主機、公用雲 overlay），
# 該 hop 亦須加密（例如上游改用 https 並驗證憑證，或走加密隧道）；「有 LB」不等同完整 TLS。
#
# 轉給前端的 Host 標頭必須完整帶上使用者實際連的對外埠。後端在未設
# CORS_ALLOWED_ORIGINS 時只接受同源請求，判斷方式是把請求的 Origin 與 Host 相比；
# 對外埠不是 443 時，少了 `:埠` 的 Host 就與瀏覽器送出的 Origin 對不起來，
# 需要憑證的請求會被判為跨源。$host 只保有主機名，故此處改用下面的 $public_host。

# upstream 走 Docker 內建 DNS 動態解析（不用固定 upstream 區塊）：
# nginx 只在啟動時解析一次固定 upstream 的名稱，frontend 容器換 IP 後會一路 502 到代理重啟為止。
# 主機安裝 nginx 的變體沒有 127.0.0.11，改用固定位址即可（見上方第 4 點）。
resolver 127.0.0.11 valid=30s ipv6=off;

# $public_host：使用者實際連上的「主機名＋對外埠」，也就是瀏覽器會放進 Origin 的那一段。
# 對外埠為 443 時省略埠號（https 的預設埠不出現在 Origin 裡），其餘一律帶上。
#
# 不用 $http_host（原始 Host 標頭）的原因：HTTP/2 沒有 Host 標頭，該變數會是空值，
# 本代理正是 http2 on。$host 則相反——它永遠有值，但只有主機名、丟掉埠號。
# 由 $host 與 ${TLS_HTTPS_PORT} 組出的 $public_host 兩種協定版本都成立。
map "${TLS_HTTPS_PORT}" $public_host {
    "443"   $host;
    default "$host:${TLS_HTTPS_PORT}";
}

# HTTP → HTTPS redirect（80 僅做導轉，不提供內容）
server {
    listen 80;
    server_name ${TLS_DOMAIN};

    # 本地 CA 憑證的下載口（TLS_MODE=selfsigned 時才有檔案，否則 404）。
    # 也開在 80 埠：還沒信任這把 CA 的機器，正好是無法安靜地走 https 取得它的那些。
    location = /custodexa-ca.crt {
        alias /etc/nginx/ca-public/custodexa-ca.crt;
        default_type application/x-x509-ca-cert;
    }

    location / {
        # 導向要帶上 https 的對外埠；$public_host 已含埠（443 時自動省略），不必手改。
        return 301 https://$public_host$request_uri;
    }
}

# HTTPS termination
server {
    listen 443 ssl;
    http2 on;
    server_name ${TLS_DOMAIN};

    # 換上你的憑證鏈與私鑰
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # TLS 1.2+（停用過時協定）
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # HSTS（先採較短 max-age，穩定後再拉長；includeSubDomains/preload 依你的網域策略再開）
    add_header Strict-Transport-Security "max-age=86400" always;

    # 上限依你的檔案傳輸需求調整
    client_max_body_size 0;

    # 本地 CA 憑證的下載口（TLS_MODE=selfsigned 時才有檔案，否則 404）。
    # 憑證是公開資料，唯一被開放的靜態路徑就是這一條；私鑰不在這個目錄裡。
    location = /custodexa-ca.crt {
        alias /etc/nginx/ca-public/custodexa-ca.crt;
        default_type application/x-x509-ca-cert;
    }

    location / {
        # 變數形式的 proxy_pass 讓 nginx 每次請求才解析主機名（配合上面的 resolver）
        set $frontend_upstream http://frontend:80;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        # Host 要保有對外埠：後端以 Origin 對 Host 判同源（見檔頭）
        proxy_set_header Host              $public_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket upgrade 轉發（wss 必需）：終端/SFTP/圖形/監控串流走 /ws 與 /api 的 upgrade
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
    }
}

# $connection_upgrade：WebSocket 時為 "upgrade"，否則為 ""（放入 http{} 區塊，或於此 map 定義）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
