# =============================================================================
# Custodexa docker-compose 環境變數範本（dev 與 prod 共用）
# =============================================================================
# 操作流程（部署者與開發者一致）：
#   1. cp .env.example .env
#   2. 依環境編輯（務必改機密＋依需求設 DB_SSLMODE/LDAP/DATA_PATH）
#   3. docker compose up -d
#   （或一條指令：bash scripts/quickstart.sh --up——自動建檔、生成缺的機密、啟動；
#    已填的值一律不動）
#
# 預設的 docker-compose.yml 是「正式版」：nginx 供編譯後的前端、backend 為精簡二進位、
# 不含測試靶機。想部署自用者做到這裡即可。
#
# 參與開發者多一步：取消下方 COMPOSE_FILE 的註解，此後所有 docker compose 指令
# （含 exec ... go test）自動指向開發版，無須每次打 -f。開發版提供前端熱重載、
# 後端 Air 熱重載＋完整 Go 工具鏈，以及 ssh/rdp/vnc/ldap/mysql/k3s 六個測試靶機。
# 顯式 -f docker-compose.yml 仍可覆蓋本設定，故正式版隨時能在開發機驗證。
# 開發另建議改 KEK_PROVIDER=env 並填 ENCRYPTION_KEY（熱重載每次重編譯即重啟行程，
# ui 模式等於每次存檔都要重新解封；生成值可由 bash scripts/quickstart.sh 代填）。
#
# COMPOSE_FILE=docker-compose.dev.yml
#
# 注意：上一行必須保持註解狀態。本檔是「部署者複製後拿到正式版」的前提，
# 若在範本內給它生效值，複製者將意外取得開發版（Vite dev server、對外埠不同）。
# 本變數由 docker compose CLI 消費，非後端讀取，故不納入 env 漂移守衛的比對集合。
#
# 兩份 compose 皆以 env_file 消費本檔；docker compose 亦以 ${DATA_PATH} 決定資料落點。
# 重要：env_file 對「空值」的行內 # 註解不剝除（KEY=  # 說明 的值會變成「# 說明」），
# 而本檔多數旋鈕預設為空值，故所有說明一律置於獨立行、值行不帶行內註解。
# 拓撲/模式常數（DB_HOST=postgres、GUACD_HOST=guacd、DB_DRIVER、GIN_MODE、容器內路徑）
# 由 compose 檔的 environment: 提供，不在此列——改網路服務名才需動 compose。
# 其中資料庫驅動（DB_DRIVER）無出廠預設值，缺它即拒絕啟動：PostgreSQL 是唯一正式部署
# 目標，程式碼中的 sqlite 分支只服務單元測試（版本化 migration 一律 PG 語法，選它必在
# 遷移階段崩潰）。以 compose 啟動者不會遇到該錯誤（兩份 compose 都已供給），但以裸二進位
# 或自製編排（k8s manifest、systemd unit）部署者必須在該處自行供給此值；寫進本檔無效，
# 因為 compose 的 environment: 優先於 env_file。
# 本檔為唯一環境變數範本；後端消費變數的完備性由 env_drift_test.go 守衛
# （對照本檔 ＋ compose 提供的拓撲變數）。
# 標記：[機密] 生產務必改值；[PCI] 合規建議值；[播種] 僅首啟寫入政策，之後由政策頁管理。
# =============================================================================

# ---- 資料存放位置 ----
# 主體應用資料（審計 / 錄影 / 資料庫）的資料夾根，bind mount 映入容器。
# 預設專案內 ./data（開發可直接檢視）；生產覆寫為指定資料夾或磁碟，例如 /opt/custodexa/data。
DATA_PATH=./data

# ---- 資料庫（compose 內 postgres 服務的命名與認證，dev/prod 皆由此驅動）----
DB_NAME=custodexa
DB_USER=postgres
# [機密] dev 預設；生產務必改為強密碼。
DB_PASSWORD=postgres
# 內建 compose postgres 走同主機隔離 bridge 無 TLS → disable；
# 連外部 DB（跨網路）務必改 require 或 verify-full（PCI Req 4）。
DB_SSLMODE=disable

# ---- 安全（機密）----
# JWT_SECRET 即出廠預設；release（prod）偵測到未改即拒啟動（fail-close，PCI 2.2.2）。dev（debug）可照抄。
# [機密][PCI 2.2.2] JWT_SECRET 為 HS256 認證信任根，必須 >= 32 bytes（不足則拒絕啟動）。
# 生產請換為 CSPRNG 生成的隨機字串，例如 openssl rand -base64 32。
JWT_SECRET=change-me-in-production-dev-secret
#
# ---- KEK（信封加密的金鑰加密鑰）----
# KEK 是保護資料庫內所有密文欄位（資產憑證、SFTP 密碼、TOTP、通知 secret 等）的根金鑰。
# **出貨預設＝ui（金鑰不落地）**。先讀懂各模式的營運後果，再決定要不要換：
#
#   ui （出貨預設）：金鑰材料**只存在於記憶體**——首次啟動於瀏覽器的初始化頁本地生成、
#        之後每次由管理者在解封頁輸入，**永不落地**，磁碟上任何檔案都沒有這把鑰匙。
#        代價＝**每次行程重啟（含當機重啟、主機重開、容器重建）都會停在封印狀態，
#        必須有人再輸入一次才會恢復服務**。無人值守的環境請改用 env 或 kms。
#
#   env：改設 KEK_PROVIDER=env，並取消下方 ENCRYPTION_KEY 註解、填入生成值
#        （bash scripts/quickstart.sh 會在 env 宣告下代生成）。金鑰材料**以明文存在
#        伺服器磁碟上**，重啟不需要人介入，適合無人值守的部署與開發熱重載。
#        代價＝任何讀得到這個檔案的人（備份、快照、誤設的權限）就拿到了根金鑰。
#
#   kms／hsm：委託雲端金鑰服務或硬體模組，見下方委託模式組態。
#
# KEK_PROVIDER 大小寫敏感；白名單外的值（含 ENV）一律拒絕啟動，不猜測、不回落。
# **留空＝等同未設**：此時若有 ENCRYPTION_KEY 則走向後相容的 env 模式，
# 若也沒有 ENCRYPTION_KEY 則**拒絕啟動**（留空不會被推斷為 ui；ui 是本範本的顯式出貨值，
# 不是執行期預設）。
KEK_PROVIDER=ui
#
# [機密][PCI 2.2.2] KEK 材料：一把 **32 位元組**的金鑰。
# 「32 位元組」是金鑰長度，不是輸入字串長度——下列三種寫法都會被接受：
#   1. 恰 32 個字元（A-Z a-z 0-9）
#   2. 64 個十六進位字元
#   3. base64（標準或 URL-safe、有無 padding 皆可），解碼後恰 32 位元組
# 解碼後不是 32 位元組者一律拒絕；系統不會以任何方式把不足的材料補足。
#
# **本鍵刻意保持註解狀態**：僅 `KEK_PROVIDER=env` 需要本鍵——ui（出貨預設）／kms／hsm
# 下本鍵**必須維持註解**，有值即組態矛盾拒絕啟動。改用 env 時自行填入生成值
#（金鑰類設定無出廠預設值；照抄公開已知的值＝所有部署共用同一把 KEK）。
# 請用 CSPRNG 生成、勿自行編造（低熵字串通過長度檢查但不安全）。下列任一皆可：
#   openssl rand -hex 32
#   openssl rand -base64 32
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
# （三條指令各對應上述一種寫法，且每一條都由守衛測試實跑驗證其產出必然通過驗證。
#  注意是 `-base64 32` 不是 `-base64 24`：後者只有 24 位元組的隨機量。）
# KEK 材料鍵**只有這一把**（無別名、無回落鍵）。
# 注意：**不可把本鍵設為空字串來「關閉」它**——空值等同無材料，env 模式會拒絕啟動；
# 不落地（ui，出貨預設）下本鍵整行維持註解（＝未設）即正確。
# 取消下一行註解並填入生成值即可啟動：
# ENCRYPTION_KEY=
#
# 委託模式組態（KEK_PROVIDER=kms／hsm 時逐鍵齊備檢查；缺項會逐鍵列出）。
# 本地 KEK 材料鍵必須全部未設，否則判為組態矛盾拒絕啟動。
#
# KEK_KMS_PROVIDER 目前僅支援 aws；KEK_KMS_KEY_ID 可填 alias／裸 key-id／完整 ARN，
# 啟動時一律經 DescribeKey 正規化為 key ARN 後才落庫（三種寫法等價，改寫不影響開機）。
# 憑證來源走 AWS SDK 預設鏈（IRSA／instance profile／AWS_* 環境變數／SSO），
# 本產品不代管雲端憑證、也不提供端點覆寫旋鈕。
# 端點覆寫在生產路徑一律拒絕啟動：AWS_ENDPOINT_URL_KMS 與 AWS_ENDPOINT_URL
# 由 AWS SDK 直接解析，會把含明文 DEK 的 kms:Encrypt 請求導向該位址（可為 HTTP 明文），
# 故任一有值即 fail-close；~/.aws/config 的 endpoint_url 亦同。
# KEK_KMS_KEY_ID 另有第二個作用：它宣告本部署信任哪個 KMS 帳號。換鑰精靈的委託
# 重包目標（請求體的 key_ref）必須與本鍵屬於同一 partition 與同一 AWS 帳號，
# 否則拒絕受理——只沿用 region 擋不住「重包到同區的他人帳號」。
# 所需 IAM action：kms:DescribeKey、kms:Encrypt、kms:Decrypt；
# C1↔C1 換金鑰另需 kms:ReEncryptFrom 與 kms:ReEncryptTo（兩個，非單一 kms:ReEncrypt）。
# 啟動時除 DescribeKey 外另跑一次不落庫的 Encrypt→Decrypt 往返：metadata 合格
# 不代表有加解密權限（也不代表 XKS 外部金鑰存放區可達），故實打一次才算驗過。
# 多區域金鑰（MRK）可作為 KEK，但本版把 primary 與 replica 視為兩把不同的鑰
# （落庫的 kek_id 含 region）：切到 replica 等同換鑰，須先走換鑰精靈重包。
# A/B→C 遷移順序：先設好本區三鍵（此時仍以 env／ui 模式運行）→ 於換鑰精靈指定
# 目標 key_ref 重包 → 移除本地 KEK 材料鍵並設 KEK_PROVIDER=kms → 重啟。
# KEK_KMS_PROVIDER=
# KEK_KMS_KEY_ID=
# KEK_KMS_REGION=
# KEK_HSM_MODULE=
# KEK_HSM_TOKEN_LABEL=
# KEK_HSM_KEY_LABEL=
# [機密] KEK_HSM_PIN 與 KEK_HSM_PIN_FILE 須**恰一有值**（皆設＝組態矛盾，不做隱式優先序）。
# KEK_HSM_PIN=
# KEK_HSM_PIN_FILE=
# [機密][PCI 8.3.6/2.2.2] ADMIN_INITIAL_PASSWORD：全新（空 DB）部署建立初始 admin 的密碼。
# 移除了硬編碼公開預設 admin123——凡會 seed 的部署（含 dev 全新 DB）都必須自行設定合格值，
# 下方 placeholder 已列入 denylist，任何模式空 DB 啟動若仍為此值/過短(<12)/含空白換行即拒啟動。
# 設定高熵值（建議 openssl rand -base64 24，去除尾端換行）；首次登入強制改密後即退役，
# 請於首登完成後自本檔移除或輪替（非空 DB 啟動若仍留有效值會告警）。既有非空 DB 不需此值。
ADMIN_INITIAL_PASSWORD=change-me-admin-initial-password-in-env

# ---- 伺服器 ----
# 註：GIN_MODE 由 compose 依環境固定（dev=debug / prod=release），非部署旋鈕故不列於此。
# [PCI 7.3] 逗號分隔 allowlist；留空=release 僅同源。
CORS_ALLOWED_ORIGINS=

# 營運指標端點 /metrics 的 bearer token（observability-lite）。
# 留空＝免認證。**留空是安全的預設**：/metrics 不在 /api 之下，而正式版 edge 只代理
# /api 與 /ws，故此端點預設自外部打不到。
# **若你為了跨機採集而在反向代理上開了 /metrics 的通道，就必須同時設定本值**——
# 否則等於把系統的端點清單、各功能使用量與錯誤率公開。
METRICS_TOKEN=

# ---- 功能開關 ----
# 註：權限檢查**沒有開關**（security-backlog-settlement）——它於所有模式無條件
# 生效。安全紅線中「任何組態都不該關」者，正確處置是不提供開關，而非提供後於
# release 模式強制。
#
# 下鍵屬 release 安全底線：GIN_MODE=release 時設為 false 會被忽略並強制啟用，
# 被強制的鍵名列於啟動日誌（全操作審計為安全紅線，不可由部署層關閉）。
FEATURE_AUDIT_LOG_ENABLED=true
FEATURE_ASYNC_AUDIT_ENABLED=true
FEATURE_AUDIT_FALLBACK_TO_FILE=true
FEATURE_ANOMALY_DETECTION_ENABLED=false
FEATURE_ALERTING_ENABLED=false

# ---- OIDC 身分提供者整合 ----
# provider 本身的設定（issuer / client_id / secret / 准入規則）由管理端存入資料庫，
# 此處只放「部署層才該決定」的三項。
#
# 啟用 SSO 前必讀的兩項運維前提（完整說明見 docs/QUICKSTART.md「OIDC／SSO 部署注意」）：
#
# 1. **必須保留至少一個本地 admin 帳號**。系統以不變式擋住「本地 admin 自一以上降為零」，
#    但這不只是「IdP 掛了進不去」的問題——封印解封（KEK_PROVIDER=ui）與初始管理員驗證
#    只認本地憑證，該路徑發生在系統尚未完全啟動的階段，不可能經外部 IdP 完成。
#    全體 admin 都外部化＝一旦進入封印狀態即無人能解封。該帳號應設強密碼並啟用 MFA。
#
# 2. **IdP 端停權不會自動終斷進行中的協議連線**。OIDC 無反向通知（本版未實作
#    back-channel logout），既有 SSH/RDP/VNC 連線建立後不再使用憑證故會繼續存活，
#    由閒置逾時與最大連線時長治理；已簽發的 access token 亦存活至到期（15 分鐘）。
#    IdP 端停權的實際效果是「下次登入被拒」。需要即時切斷者，一律在本系統管理端
#    停用該帳號或停用整個 provider（兩者皆會撤憑證＋終斷連線＋收線監看訂閱）。

# 對外基準網址：用於組出交給 IdP 的 redirect_uri 與 callback 導回位址。
# **不從請求 Host 推導**——反向代理多層轉發下推導必然出錯，而該值會被寫進
# redirect_uri，錯誤時使用者會被導向錯誤主機。
# 未設定時，已啟用的 provider 會被標記「設定不完整」並自登入頁隱藏（fail-close）。
# 正式環境須為 https（例：https://bastion.example.com）。
PUBLIC_BASE_URL=

# 專屬 issuer 宣告（逗號分隔）。
# 系統對「未知 issuer」一律 fail-close 視為共用身分域，並要求其准入規則包含
# 組織歸屬條件（租戶識別或 hosted domain）。但 Okta、自架 IdP 等**不發**這類
# claim，若無本宣告，它們的自動供應將無法組態。
# 宣告的語義是「此 issuer 只服務本組織」——該判斷只有部署方能做，故置於部署層
# 而非管理端 API（admin 帳號自身不得放寬安全規則）。
# 內建的共用清單（Google、Microsoft 多租戶端點等）優先，不可經此宣告推翻。
# 變更後須滾動重啟全部副本才算生效。
# 例：OIDC_DEDICATED_ISSUERS=https://acme.okta.com,https://idp.internal.example
OIDC_DEDICATED_ISSUERS=

# 允許出站的內部主機名（逗號分隔）。
# 對 IdP 的出站預設拒絕解析至 loopback／link-local（含雲端 metadata 位址）／
# 私有網段，內網 IdP 須於此顯式放行。不提供「關閉位址檢查」的布林開關。
# 非 release 模式下，列於此的主機名同時允許 http（供 dev IdP 靶機使用）。
OIDC_ALLOWED_INTERNAL_HOSTS=

# ---- LDAP 認證（seed 專用，非執行期設定）----
# 下列九個 LDAP_* 鍵僅在「首次啟動且資料表為空且 LDAP_ENABLED=true」時
# 一次性寫入資料庫；之後一律以管理端「身分管理 → LDAP 目錄」頁為準，
# 改本檔不生效（系統會記錄評估完成標記，不因資料列被刪而重跑）。
# 例外：LDAP_ALLOWED_LOOPBACK_ENDPOINTS 為執行期出站政策，不屬 seed。
# 降版至舊版本前須先把管理端現行設定回填本檔（含 bind 密碼），見 docs/QUICKSTART.md。
# 預設關閉；dev 要測 LDAP 改 LDAP_ENABLED=true（下列值已對齊內建 ldap-test 服務）。
# 生產：改 LDAP_URL 為真實目錄伺服器並填對應 DN / 密碼。
LDAP_ENABLED=false
# dev 內建測試服務；生產改真實伺服器（ldap:// 或 ldaps://）。
LDAP_URL=ldap://ldap-test:1389
LDAP_BIND_DN=cn=admin,dc=example,dc=org
# [機密] dev 測試值；生產改真實。
LDAP_BIND_PASSWORD=adminpass
LDAP_BASE_DN=ou=users,dc=example,dc=org
LDAP_USER_FILTER=(uid=%s)
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FULLNAME=cn
# 僅測試自簽憑證用；生產務必 false。
LDAP_SKIP_TLS_VERIFY=false
# 允許出站的 loopback 端點（逗號分隔，host:port 精確比對、不支援萬用字元）。
# LDAP 撥號預設拒絕 loopback／link-local（含雲端 metadata 位址）／未指定／multicast；
# 私有網段預設放行（目錄服務常態位置為內網）。不提供「關閉位址檢查」的布林開關。
# 目錄跑在本機同一台時（如 127.0.0.1:1389）於此顯式放行。
LDAP_ALLOWED_LOOPBACK_ENDPOINTS=

# ---- 會話逾時（分鐘；[播種] 首啟播種政策，之後由安全政策頁管理）----
# [PCI 8.2.8 建議 15]；0=停用。
SSH_IDLE_TIMEOUT_MINUTES=30
# 0=不限。
SSH_MAX_SESSION_MINUTES=0

# ---- 審計 / 錄影 / 運維上限 ----
# [PCI 10.5.1 建議 365][播種] 留空=政策預設 90。
RECORDING_RETENTION_DAYS=
# [播種] 檢查點封存週期秒數；留空=3600。上限 86400（24 小時），0/非法值退回預設。
# 首次啟動後由「系統設定→安全政策」為準，此處僅為初值（政策頁設定後 env 不再介入）。
AUDIT_CHECKPOINT_INTERVAL_SECONDS=
# [播種] 檢查點封存筆數門檻；留空=10000。上限 1000000，與週期先到先觸發。
AUDIT_CHECKPOINT_ROW_THRESHOLD=
# 換鑰單次重加密上限；留空或非法=100000。
KEY_ROTATION_MAX_PER_RUN=
# 保留清理單次刪除上限；留空或非法=100000。
RETENTION_MAX_PER_RUN=
# k8s list 逾時秒數；留空或非法=10。
K8S_LIST_TIMEOUT_SECONDS=

# ---- 封印狀態機 / 解封端點（KEK_PROVIDER=ui 時生效）----
# 全部鍵皆可留空（採內建安全預設）。B 模式的 KEK 材料只由解封 API 進入記憶體，
# 本段一律是速率、來源與監聽面的旋鈕，不承載任何金鑰材料。
# 封印期留痕（journal）落點沿用 AUDIT_LOG_PATH 所在目錄，**不另設鍵**。
# per-來源退避基準秒數；留空或非法=2。
SEAL_UNSEAL_BACKOFF_BASE_SECONDS=
# per-來源退避封頂秒數（退避成長必須有上限，使「等待即可再試」恆成立）；留空或非法=300。
SEAL_UNSEAL_BACKOFF_MAX_SECONDS=
# 觸發全域冷卻的連續材料失敗次數（明顯高於 per-來源）；留空或非法=20。
SEAL_UNSEAL_COOLDOWN_THRESHOLD=
# 全域冷卻基準秒數；冷卻期滿自動恢復，任何情況都不需重啟行程。留空或非法=60。
SEAL_UNSEAL_COOLDOWN_SECONDS=
# 全域冷卻封頂秒數；留空或非法=900。
SEAL_UNSEAL_COOLDOWN_MAX_SECONDS=
# 可信代理清單（IP 或 CIDR，逗號分隔）。**未設定時 per-IP 退避保守降級為全域退避**：
# 無可信代理鏈約定時限速鍵可被轉送標頭污染，寧可影響可用性也不提供可繞過的假防線。
TRUSTED_PROXIES=
# 解封端點獨立監聽位址（如 127.0.0.1:8081）；留空=與主服務共用監聽。
SEAL_UNSEAL_BIND_ADDR=
# 解封端點允許的來源網段（CIDR 或裸 IP，逗號分隔）；留空=不限制。
# 建議搭配管理網段使用——未認證端點上任何速率手段都無法保證管理員可用性。
SEAL_UNSEAL_ALLOWED_CIDRS=
